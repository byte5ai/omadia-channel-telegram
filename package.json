{
  "name": "@omadia/channel-telegram",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-ui-assets.mjs && node scripts/build-zip.mjs ",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "clean": "rm -rf dist out .test-build *.tsbuildinfo"
  },
  "peerDependencies": {
    "@omadia/channel-sdk": "*",
    "@omadia/orchestrator": "*",
    "@omadia/plugin-api": "*",
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@omadia/channel-sdk": "file:../odoo-bot/middleware/packages/harness-channel-sdk",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.1",
    "express": "^5.0.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "Telegram channel plugin for Omadia. Implements @omadia/channel-sdk's ChannelPlugin contract: Bot-API webhook + optional long-polling fallback, MarkdownV2 rendering, inline-keyboard interactives, chat-member roster, and HTTP route for the Telegram webhook endpoint. Self-contained \u2014 no depends_on relationship to other integrations.",
  "license": "MIT",
  "homepage": "https://github.com/byte5ai/omadia-channel-telegram",
  "repository": {
    "type": "git",
    "url": "https://github.com/byte5ai/omadia-channel-telegram.git"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
